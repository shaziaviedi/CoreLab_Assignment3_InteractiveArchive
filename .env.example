PORT=3001
VITE_SOCKET_URL=http://localhost:3001
VITE_ENABLE_COLLAB=true
# Keep / locally. GitHub Actions supplies the Pages repository path for deployment.
VITE_BASE_PATH=/
# Exact origins only. GitHub Pages uses the account origin, without the repo path.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shaziaviedi.github.io,https://core-lab-assignment3-interactive-ar.vercel.app
CONTRIBUTION_LIMIT=6
CONTRIBUTION_WINDOW_MS=60000
