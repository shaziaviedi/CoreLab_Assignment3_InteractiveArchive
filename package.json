{
  "name": "corelab-assignment3-interactivearchive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --import tsx --test server/tests/*.test.js",
    "dev:offline": "vite --mode offline",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:verify": "node scripts/verify-asset-textures.mjs",
    "deployment:check": "node scripts/deployment/check-config.mjs",
    "build:verify": "node scripts/deployment/verify-build.mjs",
    "deployment:verify": "node scripts/deployment/verify-live.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "express": "^5.3.0",
    "meshoptimizer": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/test-renderer": "^8.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "vite": "^6.4.4"
  }
}
